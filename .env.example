# Copy to .env and configure values as needed
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Directory paths
TEMP_DIR=./temp
OUTPUT_DIR=./outputs

# Tier 2: Unofficial Spotify Lyrics Configuration
# Obtain sp_dc cookie from browser DevTools -> Application -> Cookies -> open.spotify.com
SP_DC_COOKIE=your_spotify_sp_dc_cookie_here
SPOTIFY_LYRICS_API_URL=https://spotify-lyrics-api-pi.vercel.app

# Tier 3: Forced Alignment Configuration
# Options: "auto" (tries Aeneas CLI first, falls back to Whisper-timestamped, then acoustic VAD), "aeneas", "whisper"
ALIGNMENT_ENGINE=auto
WHISPER_MODEL_SIZE=small
DEFAULT_ALIGNMENT_LANG=si

